{
  "expo": {
    "name": "Pusang Gala",
    "slug": "pusang-gala",
    "version": "0.0.0",
    "orientation": "portrait",
    "platforms": [
      "android",
      "web"
    ],
    "scheme": "pusang-gala",
    "newArchEnabled": true,
    "updates": {
      "enabled": false
    },
    "android": {
      "package": "com.pusanggala.app",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "launchMode": "launcher",
          "addGeneratedScheme": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "buildArchs": [
              "arm64-v8a",
              "x86_64"
            ],
            "usesCleartextTraffic": false
          }
        }
      ],
      "expo-asset",
      "expo-file-system",
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": false
        }
      ],
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "llama.rn",
        {
          "enableOpenCLAndHexagon": false
        }
      ],
      "@maplibre/maplibre-react-native",
      "./plugins/with-offline-release.cjs",
      "./plugins/with-gradle-version.cjs",
      "./plugins/with-model-hash.cjs"
    ],
    "extra": {
      "offlineOnly": false,
      "harnessNote": "Explicit model download requires networking. Inference stays on-device. Backup disabled; route pack, map and device gates pending."
    }
  }
}
