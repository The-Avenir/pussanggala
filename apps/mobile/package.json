{
  "name": "@pusang-gala/mobile",
  "private": true,
  "version": "0.0.0",
  "description": "Pusang Gala offline commute companion",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android --device",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test scripts/*.test.cjs && vitest run src/assets/nativePackAdapter.test.ts",
    "check": "expo install --check && expo config --type prebuild",
    "android:prebuild": "expo prebuild --platform android --clean --no-install",
    "android:development": "node scripts/android-build.cjs development",
    "android:release": "node scripts/android-build.cjs release",
    "android:tooling": "node scripts/android-build.cjs tooling",
    "export:android": "expo export --platform android --output-dir dist/android",
    "web": "expo start --web",
    "check:ui-assets": "node scripts/check-ui-assets.mjs",
    "test:ui": "expo export --platform web --output-dir dist && node scripts/check-ui.mjs"
  },
  "dependencies": {
    "@pusang-gala/core": "*",
    "@pusang-gala/ai": "*",
    "@pusang-gala/conversation": "*",
    "@maplibre/maplibre-react-native": "11.5.0",
    "expo": "57.0.27",
    "expo-asset": "57.0.19",
    "expo-build-properties": "57.0.22",
    "expo-crypto": "57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-file-system": "57.0.7",
    "expo-location": "57.0.20",
    "expo-sqlite": "57.0.4",
    "llama.rn": "0.12.9",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "zod": "4.6.5",
    "expo-font": "57.0.4",
    "react-native-web": "0.21.2",
    "react-native-svg": "15.15.4",
    "react-native-safe-area-context": "5.7.0",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/react": "19.2.4",
    "typescript": "6.0.3",
    "playwright": "1.64.0",
    "react-native-svg-transformer": "1.5.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
