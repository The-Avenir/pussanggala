{
  "name": "pusang-gala",
  "private": true,
  "workspaces": [
    "packages/core",
    "apps/mobile",
    "apps/mobile/src/conversation",
    "apps/mobile/src/ai",
    "tools/eval/conversation"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "website:dev": "node apps/website/server.mjs",
    "website:build": "node apps/website/build.mjs",
    "website:check": "node apps/website/verify.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "mobile:check": "npm run check --workspace @pusang-gala/mobile",
    "android:prebuild": "npm run android:prebuild --workspace @pusang-gala/mobile",
    "android:development": "npm run android:development --workspace @pusang-gala/mobile",
    "android:release": "npm run android:release --workspace @pusang-gala/mobile"
  }
}
